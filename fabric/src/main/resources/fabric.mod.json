{
  "schemaVersion": 1,
  "id": "stellaris",
  "version": "${version}",
  "name": "Stellaris",
  "description": "Stellaris introduces an expansive and immersive space exploration experience within the familiar Minecraft universe. Players can discover new planets, moon and galaxies !",
  "authors": [
    "Exodus Studio"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.exodusstudio.stellaris.fabric.StellarisFabric"
    ],
    "client": [
      "org.exodusstudio.stellaris.fabric.client.StellarisFabricClient"
    ],
    "jei_mod_plugin": [
      "org.exodusstudio.stellaris.common.compats.jei.JEIPlugin"
    ]
  },
  "mixins": [
    "stellaris.mixins.json",
    "stellaris-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.5",
    "minecraft": ">=26.1",
    "java": ">=25",
    "architectury": ">=20.0.1",
    "fabric-api": "*"
  }
}
