{
  "schemaVersion": 1,
  "id": "stellaris",
  "version": "${version}",
  "name": "Stellaris",
  "description": "Stellaris introduces an expansive and immersive space exploration experience within the familiar Minecraft universe. Players can discover new planets, moon and galaxies !",
  "authors": [
    "Exodus Studio"
  ],
  "contact": {
    "homepage": "https://github.com/st0x0ef/stellaris-2.0",
    "sources": "https://github.com/st0x0ef/stellaris-2.0",
    "issues": "https://github.com/st0x0ef/stellaris-2.0/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.exodusstudio.stellaris.fabric.StellarisFabric"
    ],
    "client": [
      "org.exodusstudio.stellaris.fabric.client.StellarisFabricClient"
    ],
    "jei_mod_plugin": [
      "org.exodusstudio.stellaris.common.compats.jei.JEIPlugin"
    ],
    "jade": [
      "org.exodusstudio.stellaris.common.compats.jade.JadePlugin"
    ],
    "rei_client": [
      "org.exodusstudio.stellaris.common.compats.rei.REIPlugin"
    ]
  },
  "suggests": {
    "jade": "*",
    "jei": "*",
    "roughlyenoughitems": "*",
    "modmenu": "*"
  },
  "mixins": [
    "stellaris.mixins.json",
    "stellaris-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.5",
    "minecraft": ">=26.1",
    "java": ">=25",
    "architectury": ">=20.1.15",
    "fabric-api": "*",
    "exoconfig": ">=0.3.5",
    "potentials": "*",
    "sky_aesthetics": ">=2.1.4"
  }
}
